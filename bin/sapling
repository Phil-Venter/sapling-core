#!/usr/bin/env php
<?php

if (($argv[1] ?? '') !== 'init') {
	fwrite(STDERR, "Usage: vendor/bin/sapling init\n");
	exit(1);
}

$stubs = dirname(__DIR__) . '/stubs';
$target = getcwd();
$files = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($stubs, FilesystemIterator::SKIP_DOTS));

foreach ($files as $file) {
	$relative = substr($file->getPathname(), strlen($stubs) + 1);
	$destination = "{$target}/{$relative}";

	if (file_exists($destination)) {
		echo "skipped  {$relative}\n";
		continue;
	}

	if (!is_dir(dirname($destination))) {
		mkdir(dirname($destination), 0755, true);
	}

	copy($file->getPathname(), $destination);
	chmod($destination, $file->getPerms() & 0777);
	echo "created  {$relative}\n";
}

if (!is_dir("{$target}/app")) {
	mkdir("{$target}/app");
	echo "created  app/\n";
}

if (!file_exists("{$target}/.env")) {
	$key = base64_encode(random_bytes(32));
	file_put_contents("{$target}/.env", "APP_ENV=dev\nAPP_KEY={$key}\n");
	echo "created  .env\n";
}

$ignore = "{$target}/.gitignore";
$ignored = '';

if (is_file($ignore)) {
	$ignored = (string) file_get_contents($ignore);
}

if (!in_array('.env', explode("\n", $ignored), true)) {
	if ($ignored !== '' && !str_ends_with($ignored, "\n")) {
		$ignored .= "\n";
	}

	file_put_contents($ignore, $ignored . ".env\n");
	echo "updated  .gitignore: .env\n";
}

$composerFile = "{$target}/composer.json";

if (is_file($composerFile)) {
	$composer = json_decode((string) file_get_contents($composerFile), flags: JSON_THROW_ON_ERROR);
	$composer->autoload ??= new stdClass();
	$composer->autoload->{'psr-4'} ??= new stdClass();

	if (!isset($composer->autoload->{'psr-4'}->{'App\\'})) {
		$composer->autoload->{'psr-4'}->{'App\\'} = 'app/';
		file_put_contents($composerFile, json_encode($composer, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");
		echo "updated  composer.json: App\\ loads from app/\n";
	}
}

echo "\nNext: composer dump-autoload, add your first page to app/, then php -S localhost:8080 -t public\n";
