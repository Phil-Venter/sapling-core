{
    "name": "sapling/core",
    "description": "A small PHP framework for prototypes, one-off projects and internal tools, with no dependencies and a core you can read in a day.",
    "type": "library",
    "license": "0BSD",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "carthage-software/mago": "1.57.0",
        "pestphp/pest": "^5.3"
    },
    "suggest": {
        "ext-curl": "for Sapling\\Client\\HttpClient",
        "ext-pdo": "for Sapling\\Db and the migrations commands, with your database's driver",
        "ext-pdo_sqlite": "for Sapling\\Db::sqlite()",
        "ext-session": "for Sapling\\Http\\Session and the Csrf middleware",
        "ext-simplexml": "for Sapling\\Data::fromXml",
        "ext-sodium": "for Sapling\\Crypto",
        "ext-xmlwriter": "for Sapling\\Data::toXml"
    },
    "autoload": {
        "psr-4": {
            "Sapling\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sapling\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "format": "mago fmt",
        "check": [
            "mago fmt --check",
            "mago lint",
            "mago analyze",
            "@test"
        ],
        "mutate": [
            "@putenv XDEBUG_MODE=coverage",
            "pest --mutate --everything --covered-only --parallel"
        ]
    }
}
